<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No optional permission is declared. The delayed evaluation request is
      committed to the app-local record of truth and surfaces as the in-app
      banner, so the declared mobile constraint holds with nothing to grant
      or deny. A notification would only mirror what the banner already shows.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScpcAgent">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Public rehearsal entry point: import, run, export. Not exported; it is
             reached from the product UI by touch, keyboard or UIAutomator. -->
        <activity
            android:name=".ui.ProbeConsoleActivity"
            android:exported="false"
            android:label="@string/probe_console_title" />

        <activity
            android:name=".ui.MemoryActivity"
            android:exported="false"
            android:label="@string/memory_title" />

        <activity
            android:name=".ui.ComparisonActivity"
            android:exported="false"
            android:label="@string/comparison_title" />

        <!-- The starter AAR contributes the protected probe service and the
             signature-level permission requirement through manifest merging. Only
             the adapter class is registered here. -->
        <meta-data
            android:name="org.scpc.r2.probe.ADAPTER_CLASS"
            android:value="com.scpc.deliveryagent.probe.ProductionProbeAdapter" />
    </application>
</manifest>
