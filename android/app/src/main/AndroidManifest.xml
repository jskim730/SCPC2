<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Optional only. The synthetic E1-E4 path and the declared mobile constraint
      must complete with every optional permission denied, so a delayed outcome is
      committed to the app-local record of truth before any notification is shown.
      EvaluationNotification mirrors that record and never creates or advances a
      request, so denying this permission changes what is displayed and nothing else.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Display only. Read at render time to name the device's real connection next
      to the synthetic network state, because a judge who turns on airplane mode
      should not see the app still claiming ONLINE. Nothing in the decision path
      reads it: the agent keeps judging on the synthetic state that SET_NETWORK
      and the in-app buttons drive, which is what keeps a run reproducible off the
      device. This is an install-time permission with no runtime prompt, so the
      "every optional permission denied" path above is unaffected; if it were
      withheld anyway, the reader reports 확인 불가 and nothing else changes.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScpcAgent">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Public rehearsal entry point: import, run, export. Not exported; it is
             reached from the product UI by touch, keyboard or UIAutomator. -->
        <activity
            android:name=".ui.ProbeConsoleActivity"
            android:exported="false"
            android:label="@string/probe_console_title" />

        <activity
            android:name=".ui.MemoryActivity"
            android:exported="false"
            android:label="@string/memory_title" />

        <activity
            android:name=".ui.ComparisonActivity"
            android:exported="false"
            android:label="@string/comparison_title" />

        <!-- The starter AAR contributes the protected probe service and the
             signature-level permission requirement through manifest merging. Only
             the adapter class is registered here. -->
        <meta-data
            android:name="org.scpc.r2.probe.ADAPTER_CLASS"
            android:value="com.scpc.deliveryagent.probe.ProductionProbeAdapter" />
    </application>
</manifest>
