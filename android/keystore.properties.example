# Release signing material — template.
#
# Copy this file to `android/keystore.properties` on the machine that builds the
# final APK, and fill in the four values. That copy is git-ignored and must stay
# on that machine only: the official rules require the participant to keep the
# signing private key, keystore and password themselves, and forbid shipping any
# credential in the APK or the source bundle.
#
# Create the keystore first (it will prompt for the password interactively):
#
#   keytool -genkeypair -v -keystore scpc2-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias scpc2
#
# Back the .jks file up somewhere outside the repository. Losing it means no
# further APK can carry the same certificate.

# Path to the keystore, relative to the Gradle root (`android/`), or absolute.
# Keeping it outside the repository is fine and slightly safer.
storeFile=../scpc2-release.jks

storePassword=
keyAlias=scpc2
keyPassword=
