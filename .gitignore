# Python environments and caches
.venv/
**/__pycache__/
*.py[cod]

# Android/Gradle local state and build outputs
**/.gradle/
**/.kotlin/
**/build/
**/local.properties
.idea/
*.iml

# Local secrets and signing material
.env
.env.*
!.env.example
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key

# Scratch space. `tmp/` held extracted copies of SOURCE.zip and SAMPLE_EXPORT,
# rendered PDF pages and uiautomator dumps -- all reproducible from the frozen
# artifacts under output/submission/, and one copy leaked a local run token.
tmp/

# Generated rehearsal/runtime artifacts.
#
# `work/` is scratch space for rehearsal runs and nothing in it belongs in the
# repository: ASSIGNMENT.json carries a run_token_secret, and naming each output
# directory individually meant a run written under any other name (a second
# phase, a retry) silently became committable. Ignore the directory itself.
work/
work/APP.apk
work/PUBLIC_RUN/
work/SAMPLE_EXPORT/
work/**/*.tmp
work/**/*.log

# Submission artifacts generated from a frozen release
SAMPLE_EXPORT/
SOURCE.zip
EXPORT_INDEX.json

# Official competition Kit. Dacon distributes it from the competition page and
# verifies the release before publication; nothing in the rules grants
# redistribution. It stays on disk so tools/win_*_shim.py and
# make_probe_variants.py keep working locally, but it is not this project's
# work to publish. See docs/competition/OFFICIAL_KIT.md.
release_v3/

# Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

