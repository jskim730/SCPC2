{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scpc.example/contracts/r2-v3/evidence-index.schema.json",
  "title": "SCPC R2 v3 reference-run evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "candidate_id",
    "release_id",
    "run_id",
    "operator_run_token",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-draft"},
    "artifact_kind": {"const": "evidence_index"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operator_run_token": {"type": "string", "minLength": 1, "maxLength": 256},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "evidence_id",
            "relative_path",
            "media_type",
            "step_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9._/-]{1,512}$"
          },
          "media_type": {
            "enum": [
              "application/json",
              "text/plain",
              "image/png",
              "video/mp4"
            ]
          },
          "step_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        }
      }
    }
  }
}
