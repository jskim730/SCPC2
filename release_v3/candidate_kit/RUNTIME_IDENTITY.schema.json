{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scpc.example/contracts/r2-v3/runtime-identity.schema.json",
  "title": "SCPC R2 v3 reference-run runtime identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "candidate_id",
    "release_id",
    "run_id",
    "operator_run_token",
    "runtime_identity_start",
    "runtime_identity_end"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-draft"},
    "artifact_kind": {"const": "runtime_identity_pair"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operator_run_token": {"type": "string", "minLength": 1, "maxLength": 256},
    "runtime_identity_start": {"$ref": "#/$defs/runtime"},
    "runtime_identity_end": {"$ref": "#/$defs/runtime"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_name",
        "version_code",
        "signing_certificate_sha256",
        "app_release_sha256",
        "source_archive_sha256",
        "model_configured",
        "probe_contract_profile",
        "cumulative_invocations"
      ],
      "properties": {
        "package_name": {"type": "string", "minLength": 3, "maxLength": 255},
        "version_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version_code": {"type": "string", "minLength": 1, "maxLength": 32},
        "signing_certificate_sha256": {"$ref": "#/$defs/sha256"},
        "app_release_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "model_configured": {"type": "boolean"},
        "probe_contract_profile": {
          "const": "DACON_SIGNED_RUNNER_PROTECTED_COMPONENT_V3_DRAFT"
        },
        "cumulative_invocations": {"type": "integer", "minimum": 0, "maximum": 60}
      }
    }
  }
}
