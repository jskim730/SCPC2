{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scpc.example/contracts/r2-v3/mission-lock.schema.json",
  "title": "SCPC R2 v3 T+48 Mission lock submission copy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "candidate_id",
    "mission_id",
    "dacon_receipt_id",
    "submitted_at",
    "timezone",
    "locked_content"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-draft"},
    "artifact_kind": {"const": "mission_lock_submission_copy"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dacon_receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "submitted_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Asia/Seoul"},
    "locked_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_user",
        "core_problem",
        "long_horizon_goal",
        "primary_value",
        "e1_e4_causal_chain"
      ],
      "properties": {
        "target_user": {"type": "string", "minLength": 1, "maxLength": 2000},
        "core_problem": {"type": "string", "minLength": 1, "maxLength": 4000},
        "long_horizon_goal": {"type": "string", "minLength": 1, "maxLength": 4000},
        "primary_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "e1_e4_causal_chain": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
