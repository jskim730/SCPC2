{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scpc.example/contracts/r2-v3/self-score.schema.json",
  "title": "SCPC R2 v3 public rehearsal self-score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_class",
    "facts"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-draft"},
    "content_class": {"const": "PUBLIC_REHEARSAL_SELF_ASSESSMENT_NOT_OFFICIAL"},
    "notes": {"type": "string", "maxLength": 4000},
    "facts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-1"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-2"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-3"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-4"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-5"}}
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["probe_id"],
            "properties": {"probe_id": {"const": "CORE-6"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "observed",
          "expected_property",
          "difference",
          "evidence_ids",
          "anchor"
        ],
        "properties": {
          "probe_id": {
            "enum": ["CORE-1", "CORE-2", "CORE-3", "CORE-4", "CORE-5", "CORE-6"]
          },
          "observed": {"type": "string", "minLength": 1, "maxLength": 4000},
          "expected_property": {"type": "string", "minLength": 1, "maxLength": 2000},
          "difference": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "anchor": {"type": "integer", "minimum": 0, "maximum": 4}
        }
      }
    }
  }
}
