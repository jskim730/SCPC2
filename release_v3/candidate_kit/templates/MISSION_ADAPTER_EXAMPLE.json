{
  "schema_version": "3.0.0-draft",
  "artifact_kind": "mission_probe_adapter",
  "role_bindings": {
    "PRIMARY_GOAL": {
      "mission_meaning": "이번 주 사용자가 끝내려는 합성 준비계획",
      "production_state_field": "missionState.currentGoal",
      "evidence_path": "evidence/state/current_goal.json"
    },
    "TARGET_ENTITY": {
      "mission_meaning": "현재 계획의 합성 대상 A",
      "production_state_field": "missionState.targetEntityId",
      "evidence_path": "evidence/state/target_entity.json"
    },
    "DISTRACTOR_ENTITY": {
      "mission_meaning": "다른 사용자·목표에 속하는 합성 대상 B",
      "production_state_field": "memory.entityId",
      "evidence_path": "evidence/state/context_selection.json"
    },
    "STABLE_VALUE": {
      "mission_meaning": "session을 넘어 재사용할 사용자 선호",
      "production_state_field": "facts.stableValue",
      "evidence_path": "evidence/state/facts.json"
    },
    "ONE_OFF_VALUE": {
      "mission_meaning": "현재 session에만 적용되는 제약",
      "production_state_field": "facts.oneOffValue",
      "evidence_path": "evidence/state/facts.json"
    },
    "CURRENT_AUTHORITY": {
      "mission_meaning": "오래된 값보다 우선하는 현재 사용자 지시",
      "production_state_field": "facts.authorityVersion",
      "evidence_path": "evidence/state/authority.json"
    },
    "REVOKED_SCOPE": {
      "mission_meaning": "현재 지시로 철회된 계획 부분",
      "production_state_field": "plan.revokedScopeIds",
      "evidence_path": "evidence/state/invalidation.json"
    },
    "PRESERVED_SCOPE": {
      "mission_meaning": "부분변경 뒤에도 유효한 완료 부분",
      "production_state_field": "plan.preservedScopeIds",
      "evidence_path": "evidence/state/recovery.json"
    },
    "DELAYED_OUTCOME": {
      "mission_meaning": "나중에 도착해 다음 판단을 바꾸는 합성 결과",
      "production_state_field": "ledger.delayedOutcome",
      "evidence_path": "evidence/ledger/outcomes.json"
    },
    "EPHEMERAL_VALUE": {
      "mission_meaning": "사용자 삭제 뒤 원문이 남아서는 안 되는 값",
      "production_state_field": "facts.ephemeralValue",
      "evidence_path": "evidence/state/tombstones.json"
    }
  },
  "operation_bindings": {
    "RESET_AND_START": {
      "production_callback": "ProbeAdapter.resetAndStart",
      "observable_evidence": "새 run ID, clean repository와 invocation counter 0"
    },
    "UPSERT_FACT": {
      "production_callback": "ProbeAdapter.upsertFact",
      "observable_evidence": "authority·scope·lifetime이 있는 production fact event"
    },
    "ADVANCE_SESSION": {
      "production_callback": "ProbeAdapter.advanceSession",
      "observable_evidence": "session ID와 surface 변경 event"
    },
    "REQUEST_DECISION": {
      "production_callback": "ProbeAdapter.requestDecision",
      "observable_evidence": "production decision state와 selected context ID"
    },
    "CORRECT_FACT": {
      "production_callback": "ProbeAdapter.correctFact",
      "observable_evidence": "새 authority version과 invalidated descendant ID"
    },
    "REVOKE_SCOPE": {
      "production_callback": "ProbeAdapter.revokeScope",
      "observable_evidence": "revoked scope와 preserved scope ID"
    },
    "DELETE_FACT": {
      "production_callback": "ProbeAdapter.deleteFact",
      "observable_evidence": "원문 제거와 irreversible tombstone ID"
    },
    "SET_NETWORK": {
      "production_callback": "ProbeAdapter.setSyntheticNetwork",
      "observable_evidence": "online·offline·delayed 상태와 정직한 decision state"
    },
    "PROCESS_KILL_RELAUNCH": {
      "production_callback": "ProbeAdapter.prepareForHarnessKill",
      "observable_evidence": "Runner의 실제 kill 전 checkpoint와 relaunch 후 process epoch"
    },
    "REPLAY_EVENT": {
      "production_callback": "ProbeAdapter.replayEvent",
      "observable_evidence": "동일 event ID와 idempotency 결과"
    },
    "DELIVER_OUT_OF_ORDER": {
      "production_callback": "ProbeAdapter.deliverOutOfOrder",
      "observable_evidence": "원래 event ID·version과 reconciliation 결과"
    },
    "ADVANCE_TIME": {
      "production_callback": "ProbeAdapter.advanceVirtualTime",
      "observable_evidence": "virtual time과 도착한 delayed outcome ID"
    },
    "EXPORT_AND_END": {
      "production_callback": "ProbeAdapter.exportAndEnd",
      "observable_evidence": "final state·ledger·receipt와 result digest"
    }
  },
  "source_paths": [
    "app/src/main/java/example/probe/ProbeAdapter.kt",
    "app/src/androidTest/java/example/probe/ProbeParityTest.kt"
  ]
}
