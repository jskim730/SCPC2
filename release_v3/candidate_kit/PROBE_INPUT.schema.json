{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scpc.example/contracts/r2-v3/probe-input.schema.json",
  "title": "SCPC R2 v3 probe input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_class",
    "probe_contract_profile",
    "probe_pack_id",
    "instance_id",
    "request_nonce",
    "operator_run_token",
    "candidate_id",
    "mission_id",
    "release_attestation_id",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0-draft"},
    "content_class": {
      "enum": [
        "PUBLIC_REHEARSAL_NOT_OFFICIAL",
        "OFFICIAL_RESTRICTED_INPUT_NO_ORACLE"
      ]
    },
    "probe_contract_profile": {
      "const": "DACON_SIGNED_RUNNER_PROTECTED_COMPONENT_V3_DRAFT"
    },
    "probe_pack_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "instance_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "operator_run_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$"
    },
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "release_attestation_id": {
      "type": "string",
      "pattern": "^ra-v1:[0-9a-f]{64}$"
    },
    "surface_nonce": {"type": "string", "minLength": 1, "maxLength": 128},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "operation",
          "session_id",
          "virtual_time",
          "event_id",
          "roles"
        ],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "operation": {
            "enum": [
              "RESET_AND_START",
              "UPSERT_FACT",
              "ADVANCE_SESSION",
              "REQUEST_DECISION",
              "CORRECT_FACT",
              "REVOKE_SCOPE",
              "DELETE_FACT",
              "SET_NETWORK",
              "PROCESS_KILL_RELAUNCH",
              "REPLAY_EVENT",
              "DELIVER_OUT_OF_ORDER",
              "ADVANCE_TIME",
              "EXPORT_AND_END"
            ]
          },
          "session_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "virtual_time": {"type": "string", "format": "date-time"},
          "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "roles": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean", "null"]
            }
          }
        }
      }
    }
  }
}
